{
  "name": "personal-tech-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1",
    "npm": "11.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:site": "astro build",
    "build:search": "pagefind --site dist",
    "build": "npm run validate:content && npm run build:site && npm run build:search",
    "check": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "verify": "npm run check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.3",
    "gray-matter": "4.0.3",
    "katex": "0.18.7",
    "marked": "18.0.13",
    "marked-highlight": "2.2.4",
    "marked-katex-extension": "5.1.13",
    "sanitize-html": "2.17.7",
    "shiki": "4.4.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "5.0.1",
    "pagefind": "1.5.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
